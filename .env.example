LLM_API_KEY=
LLM_BASE_URL=https://models.sjtu.edu.cn/api/v1
LLM_MODEL=deepseek-chat
# 可选：自定义 OpenAI-compatible API 时，不配置列表则只显示 LLM_MODEL。
# 同一 API/Key 下有多个模型时，可用逗号列表，或用 JSON 设置友好短名称：
# LLM_MODELS=model-a,model-b
# LLM_MODELS_JSON=[{"id":"model-a","label":"Model A","shortLabel":"A","vision":true},{"id":"model-b","label":"Model B","shortLabel":"B"}]
# 单模型也可只设置显示名：LLM_MODEL_LABEL=My Model

LLM_VISION=auto
TAVILY_API_KEY=
WOLFRAM_APP_ID=
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
# Webhook security (optional in websocket mode). When set, HTTP callbacks
# require X-Lark signature headers and encrypted payloads are decrypted.
FEISHU_ENCRYPT_KEY=
FEISHU_EVENT_MAX_AGE_SECONDS=300
FEISHU_CONNECTION_MODE=websocket
# 2.0 enables native Markdown table rendering in modern Feishu clients;
# use legacy for older clients that do not support JSON 2.0 cards.
FEISHU_CARD_VERSION=2.0
QQBOT_APP_ID=
QQBOT_CLIENT_SECRET=

# 单个 Tool 最长等待秒数；设为 0、off 或 none 可关闭 Registry 层超时。
SJTUCLAW_TOOL_TIMEOUT_SECONDS=60

# 单个 Agent Turn 最多进行多少轮“模型调用 -> Tool 执行”；达到后安全暂停。
SJTUCLAW_MAX_AGENT_STEPS=24

# 默认只允许本机访问。仅在你清楚局域网暴露风险时改为 true。
SJTUCLAW_ALLOW_REMOTE=false

# Optional JSON endpoint for Scheduler tasks using deliveryMode=webhook.
# Leave empty unless an HTTPS receiver is configured.
SJTUCLAW_SCHEDULER_WEBHOOK_URL=
